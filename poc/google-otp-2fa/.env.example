# Shared secret for inter-service trust (PoC only — use a secrets manager in production)
SERVICE_SHARED_SECRET=change-me-in-production-use-long-random-string

# Legacy web
LEGACY_SECRET_KEY=legacy-flask-secret-key-change-me
LEGACY_TEST_USER=testuser
LEGACY_TEST_PASSWORD=TestPassword123!
# Optional: override all PoC accounts (user:pass comma-separated)
# LEGACY_TEST_ACCOUNTS=testuser:TestPassword123!,test1:test1!,test2:test2!,test3:test3!,test4:test4!,test5:test5!
LEGACY_SESSION_COOKIE_NAME=legacy_session
LEGACY_SESSION_LIFETIME_SECONDS=3600

# MFA adapter (embedded PoC TOTP or privacyIDEA)
MFA_BACKEND=embedded
# MFA_BACKEND=privacyidea
MFA_SECRET_KEY=mfa-flask-secret-key-change-me
PRIVACYIDEA_URL=http://privacyidea
PRIVACYIDEA_ADMIN_USER=admin
PRIVACYIDEA_ADMIN_PASSWORD=admin
PRIVACYIDEA_REALM=poc
PRIVACYIDEA_TOTP_PIN=
PI_DB_PASSWORD=piSecret
MFA_SESSION_COOKIE_NAME=mfa_session
MFA_COOKIE_SECURE=false
LEGACY_INTERNAL_URL=http://legacy-web:5000
MFA_OTP_WINDOW=1
MFA_MAX_OTP_FAILURES=5
MFA_RATE_LIMIT=10 per minute

# Nginx / public
PUBLIC_BASE_URL=http://localhost:8080
